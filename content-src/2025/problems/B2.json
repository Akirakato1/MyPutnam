{
  "schemaVersion": 3,
  "collectionId": "putnam",
  "setId": "2025",
  "problemId": "B2",
  "label": "B2",
  "ordinal": 8,
  "topics": ["analysis", "calculus", "integrals", "geometry"],
  "statement": {
    "blocks": [
      { "type": "heading", "level": 1, "runs": [{ "type": "text", "text": "Problem B2" }] },
      {
        "type": "paragraph",
        "runs": [
          { "type": "text", "text": "Let " }, { "type": "inlineMath", "tex": "f:[0,1]\\to[0,\\infty)" }, { "type": "text", "text": " be strictly increasing and continuous. Let " }, { "type": "inlineMath", "tex": "R" }, { "type": "text", "text": " be the region in the " }, { "type": "inlineMath", "tex": "xy" }, { "type": "text", "text": "-plane bounded by " }, { "type": "inlineMath", "tex": "x=0,x=1,y=0" }, { "type": "text", "text": ", and " }, { "type": "inlineMath", "tex": "y=f(x)" }, { "type": "text", "text": ". Let " }, { "type": "inlineMath", "tex": "x_1" }, { "type": "text", "text": " be the x-coordinate of the centroid of " }, { "type": "inlineMath", "tex": "R" }, { "type": "text", "text": ". Let " }, { "type": "inlineMath", "tex": "x_2" }, { "type": "text", "text": " be the x-coordinate of the centroid of the solid generated by rotating " }, { "type": "inlineMath", "tex": "R" }, { "type": "text", "text": " about the x-axis. Prove that " }, { "type": "inlineMath", "tex": "x_1<x_2" }, { "type": "text", "text": "." }
        ]
      }
    ]
  },
  "hints": [
    {
      "order": 1,
      "stage": "nudge",
      "title": "Write both centroids as integrals",
      "document": { "blocks": [{ "type": "paragraph", "runs": [{ "type": "text", "text": "A vertical slice of the planar region has area " }, { "type": "inlineMath", "tex": "f(x)dx" }, { "type": "text", "text": ", while a slice of the solid has volume " }, { "type": "inlineMath", "tex": "\\pi f(x)^2dx" }, { "type": "text", "text": "." }] }] }
    },
    {
      "order": 2,
      "stage": "strategy",
      "title": "Compare weighted means",
      "document": { "blocks": [{ "type": "paragraph", "runs": [{ "type": "text", "text": "After cancelling " }, { "type": "inlineMath", "tex": "\\pi" }, { "type": "text", "text": ", the two x-coordinates are weighted averages of " }, { "type": "inlineMath", "tex": "x" }, { "type": "text", "text": " with weights " }, { "type": "inlineMath", "tex": "f" }, { "type": "text", "text": " and " }, { "type": "inlineMath", "tex": "f^2" }, { "type": "text", "text": ". Increasing the weight in an increasing function should shift the mean right." }] }] }
    },
    {
      "order": 3,
      "stage": "knowledge",
      "title": "Use a double integral",
      "document": { "blocks": [{ "type": "paragraph", "runs": [{ "type": "text", "text": "Clear denominators and symmetrize the numerator. Look for the factor " }, { "type": "inlineMath", "tex": "(x-y)(f(x)-f(y))" }, { "type": "text", "text": "." }] }] }
    },
    {
      "order": 4,
      "stage": "outline",
      "title": "Show strict positivity",
      "document": { "blocks": [{ "type": "list", "ordered": true, "items": [
        [{ "type": "text", "text": "Express the numerator of " }, { "type": "inlineMath", "tex": "x_2-x_1" }, { "type": "text", "text": " as one half of a double integral." }],
        [{ "type": "text", "text": "The factors " }, { "type": "inlineMath", "tex": "x-y" }, { "type": "text", "text": " and " }, { "type": "inlineMath", "tex": "f(x)-f(y)" }, { "type": "text", "text": " have the same sign." }],
        [{ "type": "text", "text": "Strict increase makes the integrand positive on a region of positive area, while all weights are nonnegative." }]
      ] }] }
    }
  ],
  "prerequisites": [
    {
      "order": 1,
      "title": "Centroid slice formulas",
      "document": { "blocks": [{ "type": "paragraph", "runs": [{ "type": "text", "text": "For a region under " }, { "type": "inlineMath", "tex": "y=f(x)" }, { "type": "text", "text": ", area and first moment about the y-axis are " }, { "type": "inlineMath", "tex": "\\int f(x)dx" }, { "type": "text", "text": " and " }, { "type": "inlineMath", "tex": "\\int xf(x)dx" }, { "type": "text", "text": ". Rotation about the x-axis replaces the slice area by volume " }, { "type": "inlineMath", "tex": "\\pi f(x)^2dx" }, { "type": "text", "text": "." }] }] }
    },
    {
      "order": 2,
      "title": "Symmetrizing products",
      "document": { "blocks": [{ "type": "paragraph", "runs": [{ "type": "text", "text": "For integrable functions, a product of two one-dimensional integrals can be written as a double integral over the square " }, { "type": "inlineMath", "tex": "[0,1]^2" }, { "type": "text", "text": ". Swapping x and y then reveals symmetric factors." }] }] }
    },
    {
      "order": 3,
      "title": "Monotonicity sign",
      "document": { "blocks": [{ "type": "paragraph", "runs": [{ "type": "text", "text": "If " }, { "type": "inlineMath", "tex": "f" }, { "type": "text", "text": " is increasing, then " }, { "type": "inlineMath", "tex": "(x-y)(f(x)-f(y))\\ge0" }, { "type": "text", "text": " everywhere, with strict inequality away from the diagonal when the weights are positive." }] }] }
    }
  ],
  "solution": {
    "blocks": [
      {
        "type": "paragraph",
        "runs": [{ "type": "text", "text": "By vertical slices, " }, { "type": "inlineMath", "tex": "x_1=\\frac{\\int_0^1 xf(x)\\,dx}{\\int_0^1 f(x)\\,dx}" }, { "type": "text", "text": " and, after cancelling the factor " }, { "type": "inlineMath", "tex": "\\pi" }, { "type": "text", "text": " in the volume centroid, " }, { "type": "inlineMath", "tex": "x_2=\\frac{\\int_0^1 xf(x)^2\\,dx}{\\int_0^1 f(x)^2\\,dx}" }, { "type": "text", "text": ". The denominators are positive because " }, { "type": "inlineMath", "tex": "f" }, { "type": "text", "text": " is strictly increasing and nonnegative." }]
      },
      {
        "type": "paragraph",
        "runs": [{ "type": "text", "text": "Let " }, { "type": "inlineMath", "tex": "A=\\int_0^1xf(x)^2dx" }, { "type": "text", "text": ", " }, { "type": "inlineMath", "tex": "B=\\int_0^1f(x)dx" }, { "type": "text", "text": ", " }, { "type": "inlineMath", "tex": "C=\\int_0^1xf(x)dx" }, { "type": "text", "text": ", and " }, { "type": "inlineMath", "tex": "D=\\int_0^1f(x)^2dx" }, { "type": "text", "text": ". The sign of " }, { "type": "inlineMath", "tex": "x_2-x_1" }, { "type": "text", "text": " is the sign of " }, { "type": "inlineMath", "tex": "AB-CD" }, { "type": "text", "text": ". Symmetrizing over " }, { "type": "inlineMath", "tex": "[0,1]^2" }, { "type": "text", "text": " gives " }, { "type": "inlineMath", "tex": "AB-CD=\\frac12\\int_0^1\\int_0^1f(x)f(y)(x-y)(f(x)-f(y))\\,dx\\,dy" }, { "type": "text", "text": "." }]
      },
      {
        "type": "paragraph",
        "runs": [{ "type": "text", "text": "For " }, { "type": "inlineMath", "tex": "x>y" }, { "type": "text", "text": ", strict increase gives " }, { "type": "inlineMath", "tex": "f(x)>f(y)" }, { "type": "text", "text": ", so the two difference factors have the same positive sign. For " }, { "type": "inlineMath", "tex": "x<y" }, { "type": "text", "text": " they are both negative, and on the diagonal the product is zero. The weight " }, { "type": "inlineMath", "tex": "f(x)f(y)" }, { "type": "text", "text": " is nonnegative, and it is positive on a two-dimensional region because f is strictly increasing. Thus the double integral is strictly positive, so " }, { "type": "inlineMath", "tex": "AB-CD>0" }, { "type": "text", "text": " and therefore " }, { "type": "inlineMath", "tex": "\\boxed{x_1<x_2}" }, { "type": "text", "text": "." }]
      }
    ]
  },
  "sources": [
    { "kind": "problem", "label": "MAA official 2025 problems", "url": "https://maa.org/wp-content/uploads/2026/02/2025-Putnam-Problems-for-Sessions-A-and-B.pdf" },
    { "kind": "solution", "label": "MAA official 2025 solutions", "url": "https://maa.org/wp-content/uploads/2026/02/2025OfficialSolutions.pdf" }
  ]
}
