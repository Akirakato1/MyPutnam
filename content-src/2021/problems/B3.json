{
  "schemaVersion": 3,
  "collectionId": "putnam",
  "setId": "2021",
  "problemId": "B3",
  "label": "B3",
  "ordinal": 9,
  "topics": ["analysis", "calculus", "geometry"],
  "statement": {
    "blocks": [
      { "type": "heading", "level": 1, "runs": [{ "type": "text", "text": "Problem B3" }] },
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "Let " },
        { "type": "inlineMath", "tex": "h(x,y)" },
        { "type": "text", "text": " be a real-valued function that is twice continuously differentiable throughout " },
        { "type": "inlineMath", "tex": "\\mathbb R^2" },
        { "type": "text", "text": ", and define" }
      ] },
      { "type": "displayMath", "tex": "\\rho(x,y)=yh_x-xh_y." },
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "Prove or disprove: For any positive constants " },
        { "type": "inlineMath", "tex": "d" },
        { "type": "text", "text": " and " },
        { "type": "inlineMath", "tex": "r" },
        { "type": "text", "text": " with " },
        { "type": "inlineMath", "tex": "d>r" },
        { "type": "text", "text": ", there is a circle " },
        { "type": "inlineMath", "tex": "\\mathcal S" },
        { "type": "text", "text": " of radius " },
        { "type": "inlineMath", "tex": "r" },
        { "type": "text", "text": " whose center is a distance " },
        { "type": "inlineMath", "tex": "d" },
        { "type": "text", "text": " away from the origin such that the integral of " },
        { "type": "inlineMath", "tex": "\\rho" },
        { "type": "text", "text": " over the interior of " },
        { "type": "inlineMath", "tex": "\\mathcal S" },
        { "type": "text", "text": " is zero." }
      ] }
    ]
  },
  "hints": [
    {
      "order": 1,
      "stage": "nudge",
      "title": "Rotate the center",
      "document": { "blocks": [{ "type": "paragraph", "runs": [
        { "type": "text", "text": "Let " },
        { "type": "inlineMath", "tex": "D_\\phi" },
        { "type": "text", "text": " be the radius-" },
        { "type": "inlineMath", "tex": "r" },
        { "type": "text", "text": " disk centered at " },
        { "type": "inlineMath", "tex": "d(\\cos\\phi,\\sin\\phi)" },
        { "type": "text", "text": ", and study the continuous function " },
        { "type": "inlineMath", "tex": "F(\\phi)=\\iint_{D_\\phi}\\rho" },
        { "type": "text", "text": "." }
      ] }] }
    },
    {
      "order": 2,
      "stage": "strategy",
      "title": "Average over a full revolution",
      "document": { "blocks": [{ "type": "paragraph", "runs": [
        { "type": "text", "text": "Rather than locate the desired angle directly, prove that the average of " },
        { "type": "inlineMath", "tex": "F(\\phi)" },
        { "type": "text", "text": " over " },
        { "type": "inlineMath", "tex": "0\\le\\phi\\le2\\pi" },
        { "type": "text", "text": " is zero. Interchange the integration over the disk point and the center angle." }
      ] }] }
    },
    {
      "order": 3,
      "stage": "knowledge",
      "title": "Recognize an angular derivative",
      "document": { "blocks": [
        { "type": "paragraph", "runs": [
          { "type": "text", "text": "In polar coordinates " },
          { "type": "inlineMath", "tex": "(x,y)=(s\\cos\\theta,s\\sin\\theta)" },
          { "type": "text", "text": ", the chain rule gives" }
        ] },
        { "type": "displayMath", "tex": "\\frac{\\partial}{\\partial\\theta}h(s\\cos\\theta,s\\sin\\theta)=-\\rho(s\\cos\\theta,s\\sin\\theta)." }
      ] }
    },
    {
      "order": 4,
      "stage": "outline",
      "title": "Finish with continuity",
      "document": { "blocks": [{ "type": "list", "ordered": true, "items": [
        [{ "type": "text", "text": "For a fixed point of radius " }, { "type": "inlineMath", "tex": "s" }, { "type": "text", "text": ", show that the measure of center angles whose disk contains it depends only on " }, { "type": "inlineMath", "tex": "s" }, { "type": "text", "text": "." }],
        [{ "type": "text", "text": "The angular integral of " }, { "type": "inlineMath", "tex": "\\rho" }, { "type": "text", "text": " around every origin-centered circle is zero." }],
        [{ "type": "text", "text": "Conclude that " }, { "type": "inlineMath", "tex": "\\int_0^{2\\pi}F(\\phi)\\,d\\phi=0" }, { "type": "text", "text": ", then use the intermediate value theorem." }]
      ] }] }
    }
  ],
  "prerequisites": [
    {
      "order": 1,
      "title": "Angular derivatives",
      "document": { "blocks": [{ "type": "paragraph", "runs": [
        { "type": "text", "text": "At fixed radius " },
        { "type": "inlineMath", "tex": "s" },
        { "type": "text", "text": ", differentiating a function along the circle gives " },
        { "type": "inlineMath", "tex": "\\partial_\\theta h=-yh_x+xh_y" },
        { "type": "text", "text": ". The integral of this derivative over a full period is zero." }
      ] }] }
    },
    {
      "order": 2,
      "title": "Fubini and rotational symmetry",
      "document": { "blocks": [{ "type": "paragraph", "runs": [
        { "type": "text", "text": "A continuous function on the compact annulus " },
        { "type": "inlineMath", "tex": "d-r\\le\\sqrt{x^2+y^2}\\le d+r" },
        { "type": "text", "text": " is bounded, so the finite integrals may be reordered. Rotating both a point and a disk center preserves containment, making the resulting angular weight radial." }
      ] }] }
    },
    {
      "order": 3,
      "title": "Zero average of a continuous function",
      "document": { "blocks": [{ "type": "paragraph", "runs": [
        { "type": "text", "text": "If a continuous function on a connected interval never vanishes, it has a constant strict sign. Its integral cannot then be zero. Thus a continuous function with zero average must vanish somewhere." }
      ] }] }
    }
  ],
  "solution": {
    "blocks": [
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "The statement is true. For " },
        { "type": "inlineMath", "tex": "0\\le\\phi\\le2\\pi" },
        { "type": "text", "text": ", let" }
      ] },
      { "type": "displayMath", "tex": "D_\\phi=\\left\\{(x,y):\\left|(x,y)-d(\\cos\\phi,\\sin\\phi)\\right|\\le r\\right\\}" },
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "and define" }
      ] },
      { "type": "displayMath", "tex": "F(\\phi)=\\iint_{D_\\phi}\\rho(x,y)\\,dx\\,dy." },
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "The function " },
        { "type": "inlineMath", "tex": "F" },
        { "type": "text", "text": " is continuous: after translating every disk back to the fixed radius-" },
        { "type": "inlineMath", "tex": "r" },
        { "type": "text", "text": " disk, this follows from uniform continuity of " },
        { "type": "inlineMath", "tex": "\\rho" },
        { "type": "text", "text": " on a compact neighborhood of the annulus swept out by the disks." }
      ] },
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "We show that " },
        { "type": "inlineMath", "tex": "F" },
        { "type": "text", "text": " has average zero. Fubini's theorem gives" }
      ] },
      { "type": "displayMath", "tex": "\\int_0^{2\\pi}F(\\phi)\\,d\\phi=\\iint_{\\mathbb R^2}\\rho(x,y)\\,w(x,y)\\,dx\\,dy," },
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "where " },
        { "type": "inlineMath", "tex": "w(x,y)" },
        { "type": "text", "text": " is the measure of the angles " },
        { "type": "inlineMath", "tex": "\\phi" },
        { "type": "text", "text": " for which " },
        { "type": "inlineMath", "tex": "(x,y)\\in D_\\phi" },
        { "type": "text", "text": ". Simultaneously rotating the point and the center does not change this containment condition. Therefore " },
        { "type": "inlineMath", "tex": "w(x,y)=W(s)" },
        { "type": "text", "text": " depends only on " },
        { "type": "inlineMath", "tex": "s=\\sqrt{x^2+y^2}" },
        { "type": "text", "text": ". It vanishes unless " },
        { "type": "inlineMath", "tex": "d-r\\le s\\le d+r" },
        { "type": "text", "text": "." }
      ] },
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "Now write " },
        { "type": "inlineMath", "tex": "(x,y)=(s\\cos\\theta,s\\sin\\theta)" },
        { "type": "text", "text": ". By the chain rule," }
      ] },
      { "type": "displayMath", "tex": "\\begin{aligned}\\frac{\\partial}{\\partial\\theta}h(s\\cos\\theta,s\\sin\\theta)&=-s\\sin\\theta\\,h_x+s\\cos\\theta\\,h_y\\\\&=-\\rho(x,y).\\end{aligned}" },
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "Consequently, for every " },
        { "type": "inlineMath", "tex": "s>0" },
        { "type": "text", "text": "," }
      ] },
      { "type": "displayMath", "tex": "\\int_0^{2\\pi}\\rho(s\\cos\\theta,s\\sin\\theta)\\,d\\theta=0," },
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "because it is the negative integral of the derivative of a periodic function. Returning to the average and using polar coordinates, we obtain" }
      ] },
      { "type": "displayMath", "tex": "\\int_0^{2\\pi}F(\\phi)\\,d\\phi=\\int_{d-r}^{d+r}W(s)s\\cdot0\\,ds=0." },
      { "type": "paragraph", "runs": [
        { "type": "text", "text": "If " },
        { "type": "inlineMath", "tex": "F" },
        { "type": "text", "text": " never vanished, continuity on the circle of angles would force it to be everywhere positive or everywhere negative, contradicting its zero integral. Hence " },
        { "type": "inlineMath", "tex": "F(\\phi_0)=0" },
        { "type": "text", "text": " for some " },
        { "type": "inlineMath", "tex": "\\phi_0" },
        { "type": "text", "text": ", and the boundary of " },
        { "type": "inlineMath", "tex": "D_{\\phi_0}" },
        { "type": "text", "text": " is the required circle." }
      ] }
    ]
  },
  "sources": [
    { "kind": "problem", "label": "MAA official 2021 problems", "url": "https://maa.org/wp-content/uploads/2024/10/Putnam-2021-problems.pdf" },
    { "kind": "solution", "label": "MAA official 2021 problems and solutions", "url": "https://maa.org/wp-content/uploads/2024/10/Putnam-2021-problems-and-solutions.pdf" },
    { "kind": "reference", "label": "Kedlaya 2021 TeX cross-check", "url": "https://kskedlaya.org/putnam-archive/2021s.tex" }
  ]
}
