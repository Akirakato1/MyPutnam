{
  "schemaVersion": 1, "richDocumentVersion": 2, "categoryId": "laplace-fourier-transforms", "articleId": "convolution-parseval-distributions", "title": "Convolution, Parseval, and distributions", "displayOrder": 10,
  "aliases": ["Parseval theorem", "Dirac delta Fourier", "Plancherel theorem", "Fourier convolution theorem"],
  "keywords": ["fourier-angular-v1", "tempered distribution", "energy identity", "delta distribution"],
  "notation": {"blocks": [{"type": "paragraph", "runs": [{"type": "text", "text": "All constants use convention ID fourier-angular-v1; complex conjugation is written with an overline."}]}]},
  "definitions": {"blocks": [{"type": "displayMath", "tex": "(f*g)(x)=\\int_{-\\infty}^{\\infty}f(y)g(x-y)\\,dy,\\qquad \\widehat{f*g}=\\widehat f\\,\\widehat g."}, {"type": "paragraph", "runs": [{"type": "text", "text": "The Dirac delta is the distribution satisfying "}, {"type": "inlineMath", "tex": "\\langle\\delta,\\varphi\\rangle=\\varphi(0)"}, {"type": "text", "text": " for test functions."}]}]},
  "results": {"blocks": [{"type": "displayMath", "tex": "\\int_{-\\infty}^{\\infty}f(x)\\overline{g(x)}\\,dx=\\frac1{2\\pi}\\int_{-\\infty}^{\\infty}\\widehat f(\\omega)\\overline{\\widehat g(\\omega)}\\,d\\omega."}, {"type": "displayMath", "tex": "\\widehat\\delta=1,\\qquad \\widehat1=2\\pi\\delta."}, {"type": "paragraph", "runs": [{"type": "text", "text": "Plancherel extends the transform, with the shown normalization, from well-behaved integrable functions to an isometry up to the factor "}, {"type": "inlineMath", "tex": "2\\pi"}, {"type": "text", "text": " on square-integrable functions."}]}]},
  "conditions": {"blocks": [{"type": "list", "ordered": false, "items": [[{"type": "text", "text": "Classical convolution formulas require enough integrability for the integral and rearrangements to exist."}], [{"type": "text", "text": "Parseval and Plancherel equalities are interpreted in the square-integrable sense when pointwise transforms need not exist."}], [{"type": "text", "text": "Delta formulas and transforms of nondecaying functions are distribution identities, not ordinary improper integrals."}]]}]},
  "examples": [{"title": "Check Gaussian energy", "document": {"blocks": [{"type": "paragraph", "runs": [{"type": "text", "text": "For "}, {"type": "inlineMath", "tex": "f(x)=e^{-x^2/2}"}, {"type": "text", "text": " and "}, {"type": "inlineMath", "tex": "\\widehat f(\\omega)=\\sqrt{2\\pi}e^{-\\omega^2/2}"}, {"type": "text", "text": ", Parseval gives"}]}, {"type": "displayMath", "tex": "\\int e^{-x^2}\\,dx=\\frac1{2\\pi}\\int 2\\pi e^{-\\omega^2}\\,d\\omega=\\sqrt\\pi."}]}}],
  "pitfalls": {"blocks": [{"type": "list", "ordered": false, "items": [[{"type": "text", "text": "The Parseval normalization changes with the Fourier convention."}], [{"type": "text", "text": "The delta is a linear functional, not an ordinary function with a finite point value."}]]}]},
