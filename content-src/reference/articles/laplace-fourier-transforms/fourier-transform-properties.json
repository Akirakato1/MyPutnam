  "definitions": {"blocks": [{"type": "list", "ordered": false, "items": [[{"type": "inlineMath", "tex": "\\widehat{f(x-a)}=e^{-i\\omega a}\\widehat f(\\omega)"}], [{"type": "inlineMath", "tex": "\\widehat{e^{iax}f(x)}=\\widehat f(\\omega-a)"}], [{"type": "inlineMath", "tex": "\\widehat{f(ax)}=|a|^{-1}\\widehat f(\\omega/a),\\ a\\ne0"}]]}]},
  "results": {"blocks": [{"type": "displayMath", "tex": "\\widehat{f'}(\\omega)=i\\omega\\widehat f(\\omega),\\qquad \\widehat{xf(x)}=i\\frac{d}{d\\omega}\\widehat f(\\omega)."}, {"type": "displayMath", "tex": "\\widehat{f*g}=\\widehat f\\,\\widehat g,\\qquad \\widehat{fg}=\\frac1{2\\pi}(\\widehat f*\\widehat g)."}]},
