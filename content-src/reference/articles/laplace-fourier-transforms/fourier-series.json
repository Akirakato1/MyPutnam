  "keywords": ["fourier-series-period-2L-v1", "periodic function", "sine series", "cosine series"],
  "notation": {"blocks": [{"type": "paragraph", "runs": [{"type": "text", "text": "Convention ID fourier-series-period-2L-v1 uses a period "}, {"type": "inlineMath", "tex": "2L"}, {"type": "text", "text": " with "}, {"type": "inlineMath", "tex": "L>0"}, {"type": "text", "text": "."}]}]},
  "definitions": {"blocks": [{"type": "displayMath", "tex": "f(x)\\sim\\frac{a_0}{2}+\\sum_{n=1}^\\infty\\left(a_n\\cos\\frac{n\\pi x}{L}+b_n\\sin\\frac{n\\pi x}{L}\\right)."}, {"type": "displayMath", "tex": "a_n=\\frac1L\\int_{-L}^{L}f(x)\\cos\\frac{n\\pi x}{L}\\,dx,\\quad b_n=\\frac1L\\int_{-L}^{L}f(x)\\sin\\frac{n\\pi x}{L}\\,dx."}]},
  "results": {"blocks": [{"type": "paragraph", "runs": [{"type": "text", "text": "For a piecewise smooth periodic function, the series converges at "}, {"type": "inlineMath", "tex": "x"}, {"type": "text", "text": " to "}, {"type": "inlineMath", "tex": "\\tfrac12(f(x^-)+f(x^+))"}, {"type": "text", "text": ". Thus it reaches the function at continuity points and the midpoint at a jump."}]}, {"type": "paragraph", "runs": [{"type": "text", "text": "Even functions have only cosine terms; odd functions have only sine terms."}]}]},
  "conditions": {"blocks": [{"type": "list", "ordered": false, "items": [[{"type": "text", "text": "Pointwise convergence statements need regularity such as piecewise smoothness; square-integrable functions instead have an "}, {"type": "inlineMath", "tex": "L^2"}, {"type": "text", "text": " convergence theory."}], [{"type": "text", "text": "At a jump, the Fourier series generally does not converge to either one-sided value."}], [{"type": "text", "text": "Endpoint values are interpreted through the periodic extension."}]]}]},
  "examples": [{"title": "Odd sawtooth series", "document": {"blocks": [{"type": "paragraph", "runs": [{"type": "text", "text": "For the period-" }, {"type": "inlineMath", "tex": "2L"}, {"type": "text", "text": " extension of "}, {"type": "inlineMath", "tex": "f(x)=x"}, {"type": "text", "text": " on "}, {"type": "inlineMath", "tex": "(-L,L)"}, {"type": "text", "text": ","}]}, {"type": "displayMath", "tex": "x\\sim\\frac{2L}{\\pi}\\sum_{n=1}^\\infty\\frac{(-1)^{n+1}}n\\sin\\frac{n\\pi x}{L}."}]}}],
  "pitfalls": {"blocks": [{"type": "list", "ordered": false, "items": [[{"type": "text", "text": "Do not drop the factor one-half on the constant coefficient."}], [{"type": "text", "text": "State the period convention before borrowing a coefficient formula."}]]}]},
