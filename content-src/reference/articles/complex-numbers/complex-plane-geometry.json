  "results": {
    "blocks": [
      { "type": "displayMath", "tex": "z\\mapsto z+b\\quad\\text{translates by }b" },
      { "type": "displayMath", "tex": "z\\mapsto e^{i\\phi}z\\quad\\text{rotates about the origin by }\\phi" },
      { "type": "displayMath", "tex": "z\\mapsto c+e^{i\\phi}(z-c)\\quad\\text{rotates about }c" },
      { "type": "paragraph", "runs": [{ "type": "text", "text": "Multiplication by a nonzero complex number " }, { "type": "inlineMath", "tex": "a" }, { "type": "text", "text": " scales lengths by " }, { "type": "inlineMath", "tex": "|a|" }, { "type": "text", "text": " and rotates by an argument of " }, { "type": "inlineMath", "tex": "a" }, { "type": "text", "text": ". Conjugation reflects across the real axis." }] },
      { "type": "displayMath", "tex": "2K_{\\mathrm{signed}}=\\operatorname{Im}\\left(\\overline{(z_2-z_1)}(z_3-z_1)\\right)" }
