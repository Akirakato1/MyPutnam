  "conditions": {
    "blocks": [
      { "type": "list", "ordered": false, "items": [
        [{ "type": "text", "text": "The rotation formulas use counterclockwise-positive angles in the standard orientation." }],
        [{ "type": "text", "text": "Multiplication by zero collapses the plane and is not a similarity transformation." }],
        [{ "type": "text", "text": "Conjugation reverses orientation even though it preserves distances." }],
        [{ "type": "text", "text": "The signed-area expression changes sign when two vertices are exchanged and vanishes for collinear points." }]
      ] }
    ]
  },
  "examples": [
    {
      "title": "Rotate about a nonzero center",
      "document": {
        "blocks": [
          { "type": "paragraph", "runs": [{ "type": "text", "text": "Rotate " }, { "type": "inlineMath", "tex": "z=3+i" }, { "type": "text", "text": " counterclockwise by " }, { "type": "inlineMath", "tex": "\\pi/2" }, { "type": "text", "text": " about " }, { "type": "inlineMath", "tex": "c=1-i" }, { "type": "text", "text": ". Since " }, { "type": "inlineMath", "tex": "e^{i\\pi/2}=i" }, { "type": "text", "text": "," }] },
          { "type": "displayMath", "tex": "c+i(z-c)=(1-i)+i(2+2i)=-1+i" },
          { "type": "paragraph", "runs": [{ "type": "text", "text": "Both the original and rotated points lie at distance " }, { "type": "inlineMath", "tex": "|2+2i|=2\\sqrt2" }, { "type": "text", "text": " from the center." }] }
        ]
      }
    }
