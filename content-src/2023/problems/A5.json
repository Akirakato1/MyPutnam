{
  "schemaVersion": 3,
  "collectionId": "putnam",
  "setId": "2023",
  "problemId": "A5",
  "label": "A5",
  "ordinal": 5,
  "topics": ["combinatorics", "polynomials"],
  "statement": { "blocks": [
    { "type": "heading", "level": 1, "runs": [{ "type": "text", "text": "Problem A5" }] },
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "For a nonnegative integer " }, { "type": "inlineMath", "tex": "k" },
      { "type": "text", "text": ", let " }, { "type": "inlineMath", "tex": "f(k)" },
      { "type": "text", "text": " be the number of ones in the base " }, { "type": "inlineMath", "tex": "3" },
      { "type": "text", "text": " representation of " }, { "type": "inlineMath", "tex": "k" },
      { "type": "text", "text": ". Find all complex numbers " }, { "type": "inlineMath", "tex": "z" },
      { "type": "text", "text": " such that" }
    ] },
    { "type": "displayMath", "tex": "\\sum_{k=0}^{3^{1010}-1}(-2)^{f(k)}(z+k)^{2023}=0." }
  ] },
  "hints": [
    {
      "order": 1, "stage": "nudge", "title": "Separate the base-three digits",
      "document": { "blocks": [{ "type": "paragraph", "runs": [
        { "type": "text", "text": "Writing " }, { "type": "inlineMath", "tex": "k" },
        { "type": "text", "text": " digit by digit makes the weight multiplicative. First factor the generating polynomial " },
        { "type": "inlineMath", "tex": "\\sum_k(-2)^{f(k)}x^k" }, { "type": "text", "text": "." }
      ] }] }
    },
    {
      "order": 2, "stage": "strategy", "title": "Turn shifts into differences",
      "document": { "blocks": [{ "type": "paragraph", "runs": [
        { "type": "text", "text": "For the shift operator " }, { "type": "inlineMath", "tex": "E_dP(z)=P(z+d)" },
        { "type": "text", "text": ", each digit contributes " },
        { "type": "inlineMath", "tex": "I-2E_{3^j}+E_{2\\cdot3^j}" },
        { "type": "text", "text": ". Factor this as a shift followed by a centered second difference." }
      ] }] }
    },
    {
      "order": 3, "stage": "knowledge", "title": "Track only two coefficients",
      "document": { "blocks": [{ "type": "paragraph", "runs": [
        { "type": "text", "text": "A centered second difference preserves parity and lowers polynomial degree by two. After " },
        { "type": "inlineMath", "tex": "N" }, { "type": "text", "text": " such differences, a power of degree " },
        { "type": "inlineMath", "tex": "2N+3" }, { "type": "text", "text": " becomes an odd cubic. Track its cubic and linear coefficients using the binomial theorem." }
      ] }] }
    },
    {
      "order": 4, "stage": "outline", "title": "Center and solve the cubic",
      "document": { "blocks": [{ "type": "list", "ordered": true, "items": [
        [{ "type": "text", "text": "Center the variable at " }, { "type": "inlineMath", "tex": "u=z+(3^N-1)/2" }, { "type": "text", "text": "." }],
        [{ "type": "text", "text": "Use the second-difference coefficient lemma to obtain a nonzero multiple of " }, { "type": "inlineMath", "tex": "u^3+\\tfrac12(\\sum_{j=0}^{N-1}9^j)u" }, { "type": "text", "text": "." }],
        [{ "type": "text", "text": "Evaluate the geometric sum." }],
        [{ "type": "text", "text": "Set " }, { "type": "inlineMath", "tex": "N=1010" }, { "type": "text", "text": " and translate the three roots back to " }, { "type": "inlineMath", "tex": "z" }, { "type": "text", "text": "." }]
      ] }] }
    }
  ],
  "prerequisites": [
    {
      "order": 1, "title": "Digit-product generating functions",
      "document": { "blocks": [{ "type": "paragraph", "runs": [
        { "type": "text", "text": "If each base-three digit " }, { "type": "inlineMath", "tex": "0,1,2" },
        { "type": "text", "text": " contributes weights " }, { "type": "inlineMath", "tex": "1,-2,1" },
        { "type": "text", "text": ", independent digit choices give" }
      ] }, { "type": "displayMath", "tex": "\\sum_{k=0}^{3^N-1}(-2)^{f(k)}x^k=\\prod_{j=0}^{N-1}\\left(1-2x^{3^j}+x^{2\\cdot3^j}\\right)." }] }
    },
    {
      "order": 2, "title": "Centered second differences",
      "document": { "blocks": [
        { "type": "displayMath", "tex": "\\Delta_dP(u)=P(u+d)-2P(u)+P(u-d)." },
        { "type": "paragraph", "runs": [
          { "type": "text", "text": "For " }, { "type": "inlineMath", "tex": "d\\ne0" },
          { "type": "text", "text": ", this operator preserves parity and lowers the degree of a polynomial by exactly two whenever its degree is at least two." }
        ] }
      ] }
    },
    {
      "order": 3, "title": "Leading terms of a second difference",
      "document": { "blocks": [
        { "type": "displayMath", "tex": "\\Delta_du^m=m(m-1)d^2u^{m-2}" },
        { "type": "displayMath", "tex": "{}+2\\binom{m}{4}d^4u^{m-4}+\\cdots." },
        { "type": "paragraph", "runs": [
        { "type": "text", "text": "The formula follows by adding the binomial expansions at " }, { "type": "inlineMath", "tex": "u+d" },
        { "type": "text", "text": " and " }, { "type": "inlineMath", "tex": "u-d" }, { "type": "text", "text": "; odd powers of " }, { "type": "inlineMath", "tex": "d" }, { "type": "text", "text": " cancel." }
      ] }] }
    }
  ],
  "solution": { "blocks": [
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "The three answers are" }
    ] },
    { "type": "displayMath", "tex": "-\\frac{3^{1010}-1}{2},\\qquad -\\frac{3^{1010}-1}{2}\\pm\\frac{\\sqrt{9^{1010}-1}}{4}\\,\\mathrm{i}." },
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "We prove a formula with " }, { "type": "inlineMath", "tex": "N" },
      { "type": "text", "text": " in place of " }, { "type": "inlineMath", "tex": "1010" },
      { "type": "text", "text": ". Put " }, { "type": "inlineMath", "tex": "w_k=(-2)^{f(k)}" },
      { "type": "text", "text": ". The independent base-three digits give" }
    ] },
    { "type": "displayMath", "tex": "\\sum_{k=0}^{3^N-1}w_kx^k=\\prod_{j=0}^{N-1}\\left(1-2x^{3^j}+x^{2\\cdot3^j}\\right)." },
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "Let " }, { "type": "inlineMath", "tex": "E_dP(z)=P(z+d)" },
      { "type": "text", "text": " and " }, { "type": "inlineMath", "tex": "\\Delta_d=E_d-2I+E_{-d}" },
      { "type": "text", "text": ". Since all shift operators commute and" }
    ] },
    { "type": "displayMath", "tex": "I-2E_d+E_{2d}=E_d\\Delta_d," },
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "the polynomial " }, { "type": "inlineMath", "tex": "F_N(z)=\\sum_{k=0}^{3^N-1}w_k(z+k)^{2N+3}" },
      { "type": "text", "text": " satisfies" }
    ] },
    { "type": "displayMath", "tex": "F_N(z)=\\left(\\prod_{j=0}^{N-1}\\Delta_{3^j}\\right)(z+c_N)^{2N+3}," },
    { "type": "displayMath", "tex": "c_N=\\sum_{j=0}^{N-1}3^j=\\frac{3^N-1}{2}." },
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "We use the following coefficient lemma. For nonzero " },
      { "type": "inlineMath", "tex": "d_1,\\ldots,d_N" }, { "type": "text", "text": "," }
    ] },
    { "type": "displayMath", "tex": "\\Delta_{d_N}\\cdots\\Delta_{d_1}u^{2N+3}=C\\left(u^3+\\frac{d_1^2+\\cdots+d_N^2}{2}u\\right)," },
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "where " }, { "type": "inlineMath", "tex": "C=(2N+3)!\\prod_jd_j^2/3!" },
      { "type": "text", "text": " is nonzero. To verify the lemma, expand" }
    ] },
    { "type": "displayMath", "tex": "\\Delta_du^m=m(m-1)d^2u^{m-2}" },
    { "type": "displayMath", "tex": "{}+2\\binom{m}{4}d^4u^{m-4}+\\cdots." },
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "Each application lowers the degree by two and preserves parity. Induction on the number of operators, tracking the leading and next-to-leading coefficients in this expansion, gives the displayed cubic and its linear coefficient. There are no other terms because the result is odd and has degree three." }
    ] },
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "Apply the lemma with " }, { "type": "inlineMath", "tex": "d_j=3^{j-1}" },
      { "type": "text", "text": ". Since" }
    ] },
    { "type": "displayMath", "tex": "\\frac12\\sum_{j=0}^{N-1}9^j=\\frac{9^N-1}{16}," },
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "we obtain, for a nonzero constant " }, { "type": "inlineMath", "tex": "C_N" }, { "type": "text", "text": "," }
    ] },
    { "type": "displayMath", "tex": "F_N(z)=C_N\\left(u^3+\\frac{9^N-1}{16}u\\right)," },
    { "type": "displayMath", "tex": "u=z+\\frac{3^N-1}{2}." },
    { "type": "paragraph", "runs": [
      { "type": "text", "text": "Thus " }, { "type": "inlineMath", "tex": "u=0" },
      { "type": "text", "text": " or " }, { "type": "inlineMath", "tex": "u=\\pm\\mathrm{i}\\sqrt{9^N-1}/4" },
      { "type": "text", "text": ". Taking " }, { "type": "inlineMath", "tex": "N=1010" },
      { "type": "text", "text": " gives exactly the three stated values." }
    ] }
  ] },
  "sources": [
    { "kind": "problem", "label": "MAA official 2023 problems", "url": "https://maa.org/wp-content/uploads/2025/02/2023-Putnam-Problems.pdf" },
    { "kind": "solution", "label": "MAA official 2023 problems and solutions", "url": "https://maa.org/wp-content/uploads/2025/02/2023-Putnam-Problems-and-Solutions.pdf" },
    { "kind": "reference", "label": "Kedlaya 2023 TeX cross-check", "url": "https://kskedlaya.org/putnam-archive/2023s.tex" }
  ]
}
