{
  "name": "@putnam-workbook/content-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "audit-year": "node src/audit-year.mjs",
    "audit:publication": "node src/audit-publication.mjs --root ../../build/content-publication",
    "build": "node src/build-year.mjs",
    "build:publication": "node src/build-publication.mjs --source ../../content-src --library ../../content-src/library.json --publication ../../content-src/publications/content-v1.json --output ../../build/content-publication",
    "review": "node src/render-review.mjs",
    "review-year": "node src/review-year.mjs",
    "test": "node --test test/*.test.mjs",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "katex": "0.18.9",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
