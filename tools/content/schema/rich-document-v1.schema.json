{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnamworkbook.local/schema/rich-document-v1.schema.json",
  "title": "MyPutnam rich document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["blocks"],
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "inlineRun": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tex"],
          "properties": {
            "type": { "const": "inlineMath" },
            "tex": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inlineRun" }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "runs"],
      "properties": {
        "type": { "const": "paragraph" },
        "runs": { "$ref": "#/$defs/runs" }
      }
    },
    "displayMath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tex"],
      "properties": {
        "type": { "const": "displayMath" },
        "tex": { "type": "string", "minLength": 1 }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "runs"],
      "properties": {
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 1, "maximum": 4 },
        "runs": { "$ref": "#/$defs/runs" }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ordered", "items"],
      "properties": {
        "type": { "const": "list" },
        "ordered": { "type": "boolean" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/runs" }
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "alt"],
      "properties": {
        "type": { "const": "figure" },
        "path": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "$ref": "#/$defs/runs" }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/displayMath" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/figure" }
      ]
    }
  }
}
