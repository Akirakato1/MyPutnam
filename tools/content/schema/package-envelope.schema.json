{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnamworkbook.local/schema/package-envelope.schema.json",
  "title": "MyPutnam immutable content package envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packageSchemaVersion", "contentType", "contentKey", "packageRevision",
    "contentSchemaVersion", "richDocumentVersion", "minAppVersionCode",
    "declaredUncompressedBytes", "members"
  ],
  "properties": {
    "packageSchemaVersion": { "const": 1 },
    "contentType": { "enum": ["problem", "reference"] },
    "contentKey": { "type": "string", "minLength": 1 },
    "packageRevision": { "$ref": "#/$defs/sha256" },
    "contentSchemaVersion": { "type": "integer", "minimum": 1 },
    "richDocumentVersion": { "type": "integer", "minimum": 1 },
    "minAppVersionCode": { "type": "integer", "minimum": 1 },
    "declaredUncompressedBytes": { "type": "integer", "minimum": 0 },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/member" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "packageDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentType", "packageRevision", "packageSchemaVersion", "contentSchemaVersion",
        "richDocumentVersion", "path", "compressedBytes", "uncompressedBytes", "sha256",
        "minAppVersionCode"
      ],
      "properties": {
        "contentType": { "enum": ["problem", "reference"] },
        "packageRevision": { "$ref": "#/$defs/sha256" },
        "packageSchemaVersion": { "const": 1 },
        "contentSchemaVersion": { "type": "integer", "minimum": 1 },
        "richDocumentVersion": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "compressedBytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "uncompressedBytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "minAppVersionCode": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
