{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnamworkbook.local/schema/reference-categories.schema.json",
  "title": "MyPutnam reference categories",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "displayOrder", "aliases"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "displayOrder": { "type": "integer", "minimum": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
