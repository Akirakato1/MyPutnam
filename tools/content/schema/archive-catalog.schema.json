{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnamworkbook.local/schema/archive-catalog.schema.json",
  "title": "Putnam workbook archive catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentSchemaVersion",
    "contentVersion",
    "targetYears",
    "completedYears"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentSchemaVersion": { "const": 2 },
    "contentVersion": {
      "type": "string",
      "pattern": "^archive-[0-9]{4}-[0-9]{4}\\.[1-9][0-9]*$"
    },
    "targetYears": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1938, "maximum": 2100 }
    },
    "completedYears": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1938, "maximum": 2100 }
    }
  }
}

