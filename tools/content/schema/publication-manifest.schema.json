{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnamworkbook.local/schema/publication-manifest.schema.json",
  "title": "MyPutnam deterministic publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "catalogId", "catalogRevision", "generatedAt", "minAppVersionCode",
    "includedSets", "includedReferenceCategories"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "catalogRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "minAppVersionCode": { "type": "integer", "minimum": 1 },
    "includedSets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["collectionId", "setId"],
        "properties": {
          "collectionId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "setId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
        }
      }
    },
    "includedReferenceCategories": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
    }
  }
}
