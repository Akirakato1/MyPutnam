{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnamworkbook.local/schema/problem.schema.json",
  "title": "Offline mathematics library problem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionId",
    "setId",
    "problemId",
    "label",
    "ordinal",
    "topics",
    "statement",
    "hints",
    "prerequisites",
    "solution",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "collectionId": { "$ref": "#/$defs/id" },
    "setId": { "$ref": "#/$defs/id" },
    "problemId": { "$ref": "#/$defs/id" },
    "label": { "type": "string", "minLength": 1 },
    "ordinal": { "type": "integer", "minimum": 1 },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "statement": { "$ref": "https://putnamworkbook.local/schema/rich-document-v1.schema.json" },
    "hints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/hint" }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/prerequisite" }
    },
    "solution": { "$ref": "https://putnamworkbook.local/schema/rich-document-v1.schema.json" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "stage", "title", "document"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 4 },
        "stage": { "enum": ["nudge", "strategy", "knowledge", "outline"] },
        "title": { "type": "string", "minLength": 1 },
        "document": { "$ref": "https://putnamworkbook.local/schema/rich-document-v1.schema.json" }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "title", "document"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "document": { "$ref": "https://putnamworkbook.local/schema/rich-document-v1.schema.json" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "url"],
      "properties": {
        "kind": { "enum": ["problem", "solution", "reference"] },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    }
  }
}
