{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnamworkbook.local/schema/problem.schema.json",
  "title": "Offline mathematics library problem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionId",
    "setId",
    "problemId",
    "label",
    "ordinal",
    "topics",
    "statement",
    "hints",
    "prerequisites",
    "solution",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "collectionId": { "$ref": "#/$defs/id" },
    "setId": { "$ref": "#/$defs/id" },
    "problemId": { "$ref": "#/$defs/id" },
    "label": { "type": "string", "minLength": 1 },
    "ordinal": { "type": "integer", "minimum": 1 },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "statement": { "$ref": "#/$defs/richDocument" },
    "hints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/hint" }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/prerequisite" }
    },
    "solution": { "$ref": "#/$defs/richDocument" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "inlineRun": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tex"],
          "properties": {
            "type": { "const": "inlineMath" },
            "tex": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inlineRun" }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "runs"],
      "properties": {
        "type": { "const": "paragraph" },
        "runs": { "$ref": "#/$defs/runs" }
      }
    },
    "displayMath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tex"],
      "properties": {
        "type": { "const": "displayMath" },
        "tex": { "type": "string", "minLength": 1 }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "runs"],
      "properties": {
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 1, "maximum": 4 },
        "runs": { "$ref": "#/$defs/runs" }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ordered", "items"],
      "properties": {
        "type": { "const": "list" },
        "ordered": { "type": "boolean" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/runs" }
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "alt"],
      "properties": {
        "type": { "const": "figure" },
        "path": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "$ref": "#/$defs/runs" }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/displayMath" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/figure" }
      ]
    },
    "richDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks"],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "stage", "title", "document"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 4 },
        "stage": { "enum": ["nudge", "strategy", "knowledge", "outline"] },
        "title": { "type": "string", "minLength": 1 },
        "document": { "$ref": "#/$defs/richDocument" }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "title", "document"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "document": { "$ref": "#/$defs/richDocument" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "url"],
      "properties": {
        "kind": { "enum": ["problem", "solution", "reference"] },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    }
  }
}
